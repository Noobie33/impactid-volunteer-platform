# Copy to .env and replace the local-only values. Never commit .env.
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_DATABASE=impactid_dev

# Replace with a random secret before implementing login.
JWT_BEARER_SECRET=CHANGE_ME

# Optional, only when a feature explicitly imports the Redis provider.
# REDIS_URL=redis://localhost:6379
